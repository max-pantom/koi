{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Koi",
  "version": "0.2.0",
  "identifier": "design.koi.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Koi",
        "width": 1280,
        "height": 900,
        "minWidth": 860,
        "minHeight": 560,
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "backgroundColor": "#ffffff",
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "A tiny local moodboard for folders.",
    "longDescription": "Koi is a local-first moodboard for browsing image folders, GIFs, palettes, and visual references without accounts or cloud sync.",
    "copyright": "Copyright © 2026 Koi",
    "macOS": {
      "bundleName": "Koi",
      "bundleVersion": "1",
      "signingIdentity": "-",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist",
      "dmg": {
        "background": "dmg-background.png",
        "windowSize": {
          "width": 520,
          "height": 620
        },
        "appPosition": {
          "x": 260,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 260,
          "y": 450
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY1Q0VBQzEzMUFFRDg4NzQKUldSMGlPMGFFNnpPWmRtOHhocXlzZVYwamUrU3JvaGdzMWhteVZraWg1ajQ1N25nWUczZUtncGIK",
      "endpoints": [
        "https://github.com/max-pantom/koi/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
